# Browser configuration for Vite. Copy to .env.local and replace the placeholders.
# VITE_ values are bundled into the public frontend: use only the Supabase
# publishable (browser) key, never a secret or service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_BROWSER_KEY

# For the optional local Supabase stack, use the values printed by
# `npx.cmd supabase start` instead (the validator requires "localhost", not 127.0.0.1):
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_LOCAL_KEY_FROM_SUPABASE_START

# Edge Function secrets (RESEND_API_KEY, ELEVENLABS_API_KEY, ...) are set with
# `supabase secrets set`, not here. See docs/development.md.
